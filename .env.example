# Copy to .env and adjust. Never commit .env.
# ---- Docker Compose -------------------------------------------------------
POSTGRES_USER=marketos
POSTGRES_PASSWORD=marketos
POSTGRES_DB=marketos
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

# ---- Backend (read by apps/api; prefix MARKETOS_) -------------------------
MARKETOS_ENVIRONMENT=local
MARKETOS_LOG_LEVEL=INFO
MARKETOS_LOG_JSON=true
# Used when running the API outside Docker. Inside Compose it is overridden.
MARKETOS_DATABASE_URL=postgresql+asyncpg://marketos:marketos@localhost:5432/marketos
MARKETOS_CORS_ORIGINS=["http://localhost:3000"]

# Security. Credentials you enter in the UI (Telegram, Kite, LLM keys) are
# encrypted with this master key. Leave blank to auto-generate one into
# MARKETOS_SECRET_KEY_FILE on first start (Docker: the "apisecrets" volume).
# Back it up: losing it means re-entering all credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MARKETOS_SECRET_KEY=
MARKETOS_AUTH_ENABLED=true
MARKETOS_AUTH_TOKEN_TTL_HOURS=12

# Trading safety. Phase 0 rejects anything other than paper/disabled.
MARKETOS_TRADING_MODE=paper
MARKETOS_LIVE_TRADING_ENABLED=false

# ---- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
