# Copy to .env and adjust. Never commit .env.
# ---- Docker Compose -------------------------------------------------------
POSTGRES_USER=marketos
POSTGRES_PASSWORD=marketos
POSTGRES_DB=marketos
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

# ---- Backend (read by apps/api; prefix MARKETOS_) -------------------------
MARKETOS_ENVIRONMENT=local
MARKETOS_LOG_LEVEL=INFO
MARKETOS_LOG_JSON=true
# Used when running the API outside Docker. Inside Compose it is overridden.
MARKETOS_DATABASE_URL=postgresql+asyncpg://marketos:marketos@localhost:5432/marketos
MARKETOS_CORS_ORIGINS=["http://localhost:3000"]

# Trading safety. Phase 0 rejects anything other than paper/disabled.
MARKETOS_TRADING_MODE=paper
MARKETOS_LIVE_TRADING_ENABLED=false

# ---- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
